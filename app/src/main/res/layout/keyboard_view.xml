<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keyboard_container"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <View
        android:id="@+id/voiceInputGlow"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginBottom="4dp"
        android:alpha="0"
        android:background="@drawable/bg_voice_input_glow"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/aiQuickActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/aiSummarizeButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_quick_action"
            android:fontFamily="serif"
            android:gravity="center"
            android:padding="0dp"
            android:text="Summarize"
            android:textAllCaps="false"
            android:textColor="@color/ai_text"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/aiFixGrammarButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_quick_action"
            android:fontFamily="serif"
            android:gravity="center"
            android:padding="0dp"
            android:text="Fix Grammar"
            android:textAllCaps="false"
            android:textColor="@color/ai_text"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/aiExpandButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_quick_action"
            android:fontFamily="serif"
            android:gravity="center"
            android:padding="0dp"
            android:text="Expand"
            android:textAllCaps="false"
            android:textColor="@color/ai_text"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/aiPromptRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_ai_pill"
        android:minHeight="60dp"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/aiPromptContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/aiPromptToggleButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_ai_button"
                android:padding="0dp"
                android:scaleType="center" />

            <EditText
                android:id="@+id/aiPromptInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_variable"
                android:hint="Ask AI"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine"
                android:maxLines="8"
                android:minHeight="40dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/ai_text"
                android:textColorHint="@color/ai_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:id="@+id/aiPromptShimmer"
            android:layout_width="84dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_ai_shimmer"
            android:clickable="false"
            android:focusable="false"
            android:layout_gravity="top|start"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/aiPreviewPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp"
        android:visibility="gone">
        <ScrollView android:layout_width="match_parent" android:layout_height="100dp">
            <TextView android:id="@+id/aiPreviewText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="8dp" android:textSize="14sp" android:textColor="?attr/colorKeyText"
                android:accessibilityLiveRegion="polite" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/aiPreviewApply"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="@drawable/bg_special_key" android:textColor="?attr/colorKeyText"
                android:text="Apply" android:textAllCaps="false" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/aiPreviewDiscard"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="@drawable/bg_special_key" android:textColor="?attr/colorKeyText"
                android:text="Discard" android:textAllCaps="false" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/aiPreviewStop"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="@drawable/bg_special_key" android:textColor="?attr/colorKeyText"
                android:text="Stop" android:textAllCaps="false" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/aiPreviewUndo"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:background="@drawable/bg_special_key" android:textColor="?attr/colorKeyText"
                android:text="Undo" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/clipboardPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Tap to paste · hold to pin or delete"
            android:textSize="12sp"
            android:textColor="?attr/colorKeyText" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="216dp"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/clipboardItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/emojiPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/emojiSearchPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_ai_pill"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/emojiSearchIconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:padding="0dp"
                android:scaleType="center" />

            <EditText
                android:id="@+id/emojiSearchInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/inter_variable"
                android:hint="Search emoji"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textColor="@color/ai_text"
                android:textColorHint="@color/ai_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emojiMostUsedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/inter_variable"
            android:text="Most used"
            android:textColor="@color/key_text"
            android:textSize="12sp"
            android:alpha="0.7" />

        <HorizontalScrollView
            android:id="@+id/emojiSuggestionsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/emojiMostUsedRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:contentDescription="Most used emojis" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/emojiGridScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/emojiBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/emojiAllColumn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/emojiGridRow1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/emojiGridRow2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/emojiGridRow3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recentClipboardRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/recentClipboardChip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="@font/inter_variable"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Recently copied text"
            android:textAllCaps="false"
            android:textColor="?attr/colorKeyText"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/recentClipboardChevronButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:scaleType="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolbarToggleButton"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Keyboard tools"
            android:src="@drawable/ic_chevron_right_lucide"
            android:tint="?attr/colorKeyText" />
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.nboard.ime.PredictionStripView
                android:id="@+id/predictionRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/toolbarActionsRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/toolbarClipboardButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Clipboard"
                    android:src="@drawable/ic_clipboard_lucide"
                    android:tint="?attr/colorKeyText" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/toolbarSettingsButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Keyboard settings"
                    android:src="@drawable/ic_wrench_lucide"
                    android:tint="?attr/colorKeyText" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/toolbarAiButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="AI assistance"
                    android:src="@drawable/ic_ai_custom"
                    android:tint="?attr/colorKeyText" />
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/toolbarCloseButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:contentDescription="Return to typing"
                    android:src="@drawable/ic_key_lucide"
                    android:tint="?attr/colorKeyText" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/keyRowsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.nboard.ime.NearestKeyLayout
            android:id="@+id/keyRowsStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="bottom"
                android:orientation="horizontal" />
        </com.nboard.ime.NearestKeyLayout>

        <com.nboard.ime.SwipeTrailView
            android:id="@+id/swipeTrailView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/modeSwitchButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_special_key"
            android:fontFamily="@font/inter_variable"
            android:text="123"
            android:textAllCaps="false"
            android:textColor="?attr/colorKeyText"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/aiModeButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ai_button"
            android:padding="0dp"
            android:scaleType="center" />

        <Button
            android:id="@+id/leftPunctuationButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="0.85"
            android:background="@drawable/bg_key"
            android:fontFamily="@font/inter_variable"
            android:gravity="center"
            android:text=","
            android:textAllCaps="false"
            android:textColor="?attr/colorKeyText"
            android:textSize="19sp" />

        <Button
            android:id="@+id/spaceButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="5.4"
            android:background="@drawable/bg_space_key"
            android:fontFamily="@font/inter_variable"
            android:text="space"
            android:textAllCaps="false"
            android:textColor="?attr/colorSpaceText"
            android:textSize="13sp" />

        <Button
            android:id="@+id/rightPunctuationButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_key"
            android:fontFamily="@font/inter_variable"
            android:gravity="center"
            android:text="."
            android:textAllCaps="false"
            android:textColor="?attr/colorKeyText"
            android:textSize="19sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/clipboardButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_special_key"
            android:padding="0dp"
            android:scaleType="center" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/actionButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1.9"
            android:background="@drawable/bg_special_key"
            android:padding="0dp"
            android:scaleType="center" />
    </LinearLayout>

    <View
        android:id="@+id/bottomInsetSpacer"
        android:layout_width="match_parent"
        android:layout_height="36dp" />

</LinearLayout>
